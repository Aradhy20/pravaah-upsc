  updatedAt      DateTime                   @updatedAt

  @@unique([bookId, chapterNumber])
  @@index([chapterTitle])
}

model NCERTChapterQuestionLink {
  id            String       @id @default(cuid())
  chapterId     String
  chapter       NCERTChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  relevanceNote String?
  createdAt     DateTime     @default(now())

  @@unique([chapterId, questionId])
  @@index([chapterId])
  @@index([questionId])
}

