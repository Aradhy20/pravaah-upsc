datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                String                      @id @default(cuid())
  email             String                      @unique
  passwordHash      String
  fullName          String
  avatarUrl         String?
  googleId          String?                     @unique
  roleId            String
  role              Role                        @relation(fields: [roleId], references: [id])
  profile           UserProfile?
  attempts          UserAttempt[]
  responses         UserResponse[]
  testSessions      TestSession[]
  bookmarks         Bookmark[]
  notes             UserNote[]
  schedules         ReviewSchedule[]
  goals             StudyGoal[]
  activities        StudyActivity[]
  imports           ContentImportJob[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  payments          PaymentRecord[]
  refunds           RefundRecord[]
  dailyQuizAttempts DailyQuizAttempt[]
  mainsDrafts       MainsDraft[]
  videoProgress     VideoProgress[]
  sessions          Session[]
  paymentOrders     PaymentOrder[]
  topicProgress     UserTopicProgress[]
  mistakes          UserMistakeClassification[]
  supportTickets    SupportTicket[]
  usageLedger       UserUsageLedger?
  couponRedemptions CouponRedemption[]
  referralsMade     Referral[]                  @relation("ReferrerRelation")
  referralReceived  Referral?                   @relation("ReferredRelation")
  packPurchases     UserPackPurchase[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetYear        Int?     @default(2027)
  targetExam        String?  @default("UPSC_CSE")
  optionalSubject   String?
  dailyGoalMinutes  Int      @default(60)
  dailyStudyHours   Float    @default(4.0)
  preferredLanguage String   @default("en") // "en" | "hi"
  weakSubjects      String? // JSON string of weak subjects
  strongSubjects    String? // JSON string of strong subjects
  preparationStage  String?  @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  readinessIndex    Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Exam {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  stages    ExamStage[]
  createdAt DateTime    @default(now())
}

model ExamStage {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(1)
  papers     Paper[]
  createdAt  DateTime @default(now())
}

model Paper {
  id              String     @id @default(cuid())
  stageId         String
  stage           ExamStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  code            String     @unique // e.g., "GS1", "GS2"
  name            String
  totalQuestions  Int        @default(100)
  totalMarks      Int        @default(200)
  durationMinutes Int        @default(120)
  positiveMark    Float      @default(2.0)
  negativeMark    Float      @default(0.666)
  subjects        Subject[]
  questions       Question[]
  tests           Test[]
  createdAt       DateTime   @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  name      String
  slug      String   @unique
  icon      String?
  topics    Topic[]
  createdAt DateTime @default(now())
}

model Topic {
  id           String              @id @default(cuid())
  subjectId    String
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  parentId     String?
  questions    QuestionTopic[]
  subtopics    Subtopic[]
  userProgress UserTopicProgress[]
  createdAt    DateTime            @default(now())
}

model SyllabusNode {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  paperCode   String
  subjectName String
  description String?
  createdAt   DateTime @default(now())
}

model Question {
  id                     String                      @id @default(cuid())
  recordId               String?
  questionGroupId        String? // Shared ID linking English and Hindi equivalents
  examId                 String?
  examYearId             String?
  stageId                String?
  paperId                String
  paper                  Paper                       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  year                   Int
  questionNumber         Int
  questionType           String                      @default("MCQ") // MCQ, SUBJECTIVE_MAINS, ESSAY
  questionText           String
  questionTextEn         String?
  questionTextHi         String?
  questionFormat         String?                     @default("SINGLE_CHOICE") // SINGLE_CHOICE, MULTI_STATEMENT, MATCH_FOLLOWING, ASSERTION_REASONING, CHRONOLOGY, COMPREHENSION
  translationStatus      String                      @default("TRANSLATION_MISSING") // ORIGINAL_SOURCE, HUMAN_VERIFIED, MACHINE_TRANSLATED_REVIEW_REQUIRED, TRANSLATION_MISSING
  examStage              String                      @default("PRELIMS") // PRELIMS, MAINS, INTERVIEW
  sourceReference        String?
  difficulty             String                      @default("MEDIUM") // EASY, MEDIUM, HARD
  difficultyLevel        String?                     @default("MEDIUM")
  subjectId              String?
  topicId                String?
  subtopicId             String?
  marks                  Float?                      @default(2.0)
  negativeMarks          Float?                      @default(0.666)
  sourceId               String?
  sourcePage             String?
  language               String                      @default("English") // English, Hindi, Bilingual
  isStatic               Boolean                     @default(true)
  status                 String                      @default("DRAFT") // DRAFT, NEEDS_REVIEW, VERIFIED, PUBLISHED, ARCHIVED
  verifiedAt             DateTime?
  options                QuestionOption[]
  explanation            Explanation?
  answerKeys             AnswerKeyVersion[]
  answers                QuestionAnswer[]
  syllabusMappings       QuestionSyllabusMapping[]
  citations              SourceCitation[]
  topics                 QuestionTopic[]
  sources                QuestionSource[]
  testQuestions          TestQuestion[]
  attempts               UserAttempt[]
  responses              UserResponse[]
  bookmarks              Bookmark[]
  notes                  UserNote[]
  schedules              ReviewSchedule[]
  storyLinks             StoryQuestionLink[]
  ncertLinks             NCERTChapterQuestionLink[]
  mistakeClassifications UserMistakeClassification[]
  verificationStatus     String                      @default("OFFICIALLY_VERIFIED") // OFFICIALLY_VERIFIED, INDEPENDENTLY_CORROBORATED, EXPERT_REVIEWED, PENDING_VERIFICATION, DISPUTED
  examCategory           String                      @default("CSE") // CSE, CDS, NDA, CAPF, EPFO, ESE
  contentLabel           String                      @default("OFFICIAL_UPSC_PYQ") // OFFICIAL_UPSC_PYQ, TEACHER_VERIFIED_CONTENT, AI_GENERATED_EXPLANATION, GENERATED_PRACTICE_NOT_OFFICIAL_PYQ
  corpusDocumentId       String?
  corpusDocument         CorpusDocument?             @relation(fields: [corpusDocumentId], references: [id], onDelete: SetNull)
  bookletSeries          String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([paperId, year, questionNumber])
  @@index([year, paperId, status])
  @@index([questionGroupId])
  @@index([examCategory, year])
  @@index([status])
}

model QuestionStagingRecord {
  id                   String    @id @default(cuid())
  importJobId          String?
  sourceReference      String? // Document URL, booklet code, or paper series
  examCategory         String    @default("CSE") // CSE, CDS, NDA, etc.
  examStage            String    @default("PRELIMS") // PRELIMS, MAINS
  year                 Int
  paperCode            String // GS1, GS2
  questionNumber       Int
  questionFormat       String    @default("SINGLE_CHOICE") // SINGLE_CHOICE, MULTI_STATEMENT, MATCH_FOLLOWING, ASSERTION_REASONING, CHRONOLOGY, COMPREHENSION
  questionTextEn       String
  questionTextHi       String?
  optionsJson          String // JSON string of [{ code: "A", textEn: "...", textHi: "...", isCorrect: true }]
  officialAnswer       String? // A, B, C, D
  explanationEn        String?
  explanationHi        String?
  sourceCitation       String?
  subjectSlug          String?
  topicSlug            String?
  difficulty           String    @default("MEDIUM")
  translationStatus    String    @default("TRANSLATION_MISSING") // ORIGINAL_SOURCE, HUMAN_VERIFIED, MACHINE_TRANSLATED_REVIEW_REQUIRED, TRANSLATION_MISSING
  validationErrorsJson String? // JSON array of detected validation issues
  workflowStatus       String    @default("IMPORTED") // IMPORTED, EXTRACTION_COMPLETED, AWAITING_VERIFICATION, VERIFIED, APPROVED_FOR_PUBLICATION, PUBLISHED, REJECTED_OR_ARCHIVED
  publishedQuestionId  String? // Pointer to Question.id once promoted
  reviewedBy           String?
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([paperCode, year, questionNumber, examCategory])
  @@index([workflowStatus])
  @@index([year, paperCode])
}

model QuestionOption {
  id                String         @id @default(cuid())
  questionId        String
  question          Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionCode        String // A, B, C, D
  optionLabel       String? // A, B, C, D
  optionText        String
  optionTextEn      String?
  optionTextHi      String?
  translationStatus String?        @default("TRANSLATION_MISSING") // ORIGINAL_SOURCE, HUMAN_VERIFIED, MACHINE_TRANSLATED_REVIEW_REQUIRED, TRANSLATION_MISSING
  optionOrder       Int            @default(1)
  isCorrect         Boolean        @default(false)
  responses         UserResponse[]
  createdAt         DateTime       @default(now())

  @@unique([questionId, optionCode])
}

model Explanation {
  id                   String    @id @default(cuid())
  questionId           String    @unique
  question             Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  summary              String
  detailedExplanation  String
  eliminationTechnique String?
  sourceCitation       String?
  relatedConcept       String?
  explanationEn        String?
  explanationHi        String?
  translationStatus    String?   @default("ORIGINAL_SOURCE") // ORIGINAL_SOURCE, HUMAN_VERIFIED, MACHINE_TRANSLATED_REVIEW_REQUIRED, TRANSLATION_MISSING
  explanationSource    String?
  explanationType      String?   @default("PEDAGOGICAL")
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model QuestionAnswer {
  id                 String    @id @default(cuid())
  questionId         String
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText         String?
  answerOption       String // A, B, C, D, or DROPPED
  answerType         String    @default("FINAL") // FINAL, PROVISIONAL, AMBIGUOUS, DROPPED
  answerKeyType      String    @default("UPSC_FINAL_KEY") // UPSC_FINAL_KEY, UPSC_PROVISIONAL_KEY, PROVIDER_DERIVED, FACULTY_DERIVED, UNVERIFIED, NO_KEY_FOUND
  answerProvenance   String    @default("UPSC_OFFICIAL_FINAL")
  verificationStatus String    @default("OFFICIALLY_VERIFIED")
  sourceId           String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([questionId])
  @@index([answerKeyType])
}

model AnswerKeyVersion {
  id              String   @id @default(cuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  officialAnswer  String // A, B, C, D, or DROPPED
  sourceType      String   @default("UPSC_OFFICIAL_FINAL")
  sourceReference String?
  notes           String?
  createdAt       DateTime @default(now())
}

model QuestionTopic {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
}

model SourceDocument {
  id        String           @id @default(cuid())
  title     String
  sourceUrl String
  fileHash  String?
  paperCode String?
  year      Int?
  sources   QuestionSource[]
  createdAt DateTime         @default(now())
}

model QuestionSource {
  id         String         @id @default(cuid())
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Test {
  id          String         @id @default(cuid())
  paperId     String
  paper       Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isFullPaper Boolean        @default(true)
  year        Int?
  questions   TestQuestion[]
  sessions    TestSession[]
  createdAt   DateTime       @default(now())
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int

  @@unique([testId, questionId])
}

model TestSession {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId                String
  test                  Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  status                String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt             DateTime       @default(now())
  submittedAt           DateTime?
  totalTimeSpentSeconds Int            @default(0)
  totalQuestions        Int            @default(0)
  attemptedCount        Int            @default(0)
  correctCount          Int            @default(0)
  incorrectCount        Int            @default(0)
  unattemptedCount      Int            @default(0)
  rawScore              Float          @default(0.0)
  negativeMarks         Float          @default(0.0)
  netScore              Float          @default(0.0)
  responses             UserResponse[]
}

model UserAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   String?
  isCorrect        Boolean
  timeSpentSeconds Int      @default(0)
  mode             String   @default("LEARN") // LEARN, EXAM
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model UserResponse {
  id               String          @id @default(cuid())
  sessionId        String
  session          TestSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId         String?
  option           QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  selectedCode     String?
  isCorrect        Boolean         @default(false)
  isMarkedReview   Boolean         @default(false)
  timeSpentSeconds Int             @default(0)
  createdAt        DateTime        @default(now())

  @@index([sessionId])
  @@index([userId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  folderTag  String?  @default("Default")
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId, folderTag])
}

model UserNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

model ReviewSchedule {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  repetitionCount Int      @default(0)
  intervalDays    Int      @default(1)
  easeFactor      Float    @default(2.5)
  nextReviewDate  DateTime
  isResolved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, isResolved, nextReviewDate])
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String?
  targetDate  DateTime?
  targetHours Float     @default(50.0)
  isAchieved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudyActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType    String // mcq_attempted, test_completed, note_added, revision_done
  label           String
  refId           String?
  durationSeconds Int      @default(0)
  timestamp       DateTime @default(now())
}

model ContentImportJob {
  id              String   @id @default(cuid())
  adminId         String
  admin           User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  fileName        String
  paperYear       Int
  paperCode       String
  totalRecords    Int      @default(0)
  importedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorReportJson String?
  createdAt       DateTime @default(now())
}

model ContentReview {
  id         String   @id @default(cuid())
  questionId String
  reviewerId String
  action     String // APPROVED, REJECTED, EDITED
  comments   String?
  reviewedAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, ANSWER_KEY_CHANGE
  entityType  String // QUESTION, ANSWER_KEY, IMPORT_JOB
  entityId    String
  detailsJson String?
  timestamp   DateTime @default(now())
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique // "FREE", "BEGINNER", "ACHIEVER", "SCHOLAR"
  name          String
  tagline       String?
  tier          Int            @default(0) // 0: Free, 1: Beginner, 2: Achiever, 3: Scholar
  isPopular     Boolean        @default(false)
  isActive      Boolean        @default(true)
  orderIndex    Int            @default(1)
  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PlanPrice {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingInterval String // "MONTHLY", "QUARTERLY", "ANNUAL"
  amountRupees    Float // e.g. 0, 499, 1299, 3999
  currency        String   @default("INR")
  discountPercent Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([planId, billingInterval])
}

model PlanFeature {
  id          String   @id @default(cuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureCode String // "PYQ_BROWSE", "LEARN_EXPLANATIONS", "BOOKMARKS_LIMIT", "TIMED_EXAMS", "ADVANCED_ANALYTICS", "MISTAKE_REVISION"
  featureName String
  isIncluded  Boolean  @default(true)
  limitValue  Int? // null = unlimited, or e.g. 5, 50
  tooltip     String?
  createdAt   DateTime @default(now())

  @@unique([planId, featureCode])
}

model FeatureEntitlement {
  id          String   @id @default(cuid())
  featureCode String   @unique // "TIMED_EXAMS", "ADVANCED_ANALYTICS", "UNLIMITED_NOTES", "PRIORITY_SUPPORT"
  name        String
  description String
  minTier     Int      @default(1) // Minimum plan tier required
  createdAt   DateTime @default(now())
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan                @relation(fields: [planId], references: [id])
  billingInterval    String              @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUAL"
  status             String              @default("ACTIVE") // "ACTIVE", "PAST_DUE", "CANCELED", "EXPIRED", "INCOMPLETE"
  currentPeriodStart DateTime            @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean             @default(false)
  canceledAt         DateTime?
  providerSubId      String?
  events             SubscriptionEvent[]
  payments           PaymentRecord[]
  paymentOrders      PaymentOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, status, currentPeriodEnd])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String // "CREATED", "ACTIVATED", "RENEWED", "CANCELED", "PAYMENT_FAILED", "PLAN_CHANGED"
  payloadJson    String?
  createdAt      DateTime     @default(now())
}

model PaymentRecord {
  id             String         @id @default(cuid())
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String         @default("INR")
  status         String         @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "REFUNDED"
  provider       String         @default("SANDBOX") // "RAZORPAY", "STRIPE", "SANDBOX"
  providerTxId   String?        @unique
  idempotencyKey String?        @unique
  paymentMethod  String? // "UPI", "CARD", "NETBANKING"
  receiptNumber  String?
  refunds        RefundRecord[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RefundRecord {
  id               String        @id @default(cuid())
  paymentRecordId  String
  paymentRecord    PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String        @default("INR")
  reason           String?
  status           String        @default("COMPLETED") // "PENDING", "COMPLETED", "REJECTED"
  providerRefundId String?
  processedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())
}

// ==========================================
// UPI GATEWAY INTEGRATION MODELS
// ==========================================

model PaymentOrder {
  id             String                @id @default(cuid())
  clientOrderId  String                @unique // Internal unique reference, e.g. "UPICHECKOUT_1731718000_abc"
  gatewayOrderId String?               @unique // External UPI Gateway order_id, e.g. "ORD20261115ABC12345"
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType    String                @default("SUBSCRIPTION") // "SUBSCRIPTION", "TEST_SERIES", "MAINS_EVALUATION", "COURSE"
  productId      String? // Plan code ("ACHIEVER") or Test ID
  subscriptionId String?
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Float // Amount in INR rupees (e.g. 5499.00)
  amountPaise    Int // Amount in integer paise (e.g. 549900)
  currency       String                @default("INR")
  status         String                @default("PENDING") // "PENDING", "PROCESSING", "PAID", "FAILED", "EXPIRED", "UNDER_REVIEW", "REFUNDED"
  environment    String                @default("sandbox") // "live" or "sandbox"
  isTest         Boolean               @default(true)
  paymentUrl     String?
  upiIntent      String?
  utr            String? // Bank transaction reference / UTR
  metadataJson   String? // JSON metadata (e.g. billing interval, items)
  expiresAt      DateTime?
  paidAt         DateTime?
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  webhookEvents  PaymentWebhookEvent[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([gatewayOrderId])
  @@index([clientOrderId])
}

model PaymentWebhookEvent {
  id             String        @id @default(cuid())
  eventId        String        @unique // UUID from X-Event-Id header and payload event_id
  eventSequence  Int? // Monotonically increasing sequence number from outbox
  eventType      String // e.g. "order.paid", "order.expired", "order.under_review"
  orderId        String? // Gateway order_id
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  environment    String        @default("sandbox") // "live" or "sandbox"
  signature      String? // X-Signature header
  rawPayload     String // Exact raw JSON body
  status         String        @default("PROCESSED") // "PROCESSED", "IGNORED", "FAILED"
  errorDetails   String?
  occurredAt     DateTime?
  processedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([orderId, eventType])
  @@index([eventId])
}

// ==========================================
