datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  fullName     String
  roleId       String
  role         Role              @relation(fields: [roleId], references: [id])
  profile      UserProfile?
  attempts     UserAttempt[]
  responses    UserResponse[]
  testSessions TestSession[]
  bookmarks    Bookmark[]
  notes        UserNote[]
  schedules    ReviewSchedule[]
  goals        StudyGoal[]
  activities   StudyActivity[]
  imports      ContentImportJob[]
  auditLogs    AuditLog[]
  subscriptions Subscription[]
  payments      PaymentRecord[]
  refunds       RefundRecord[]
  dailyQuizAttempts DailyQuizAttempt[]
  mainsDrafts   MainsDraft[]
  sessions      Session[]
  paymentOrders PaymentOrder[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetYear        Int?     @default(2027)
  optionalSubject   String?
  dailyGoalMinutes  Int      @default(60)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Exam {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  stages    ExamStage[]
  createdAt DateTime    @default(now())
}

model ExamStage {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(1)
  papers     Paper[]
  createdAt  DateTime @default(now())
}

model Paper {
  id              String      @id @default(cuid())
  stageId         String
  stage           ExamStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  code            String      @unique // e.g., "GS1", "GS2"
  name            String
  totalQuestions  Int         @default(100)
  totalMarks      Int         @default(200)
  durationMinutes Int         @default(120)
  positiveMark    Float       @default(2.0)
  negativeMark    Float       @default(0.666)
  subjects        Subject[]
  questions       Question[]
  tests           Test[]
  createdAt       DateTime    @default(now())
}

model Subject {
  id        String   @id @default(cuid())
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  name      String
  slug      String   @unique
  icon      String?
  topics    Topic[]
  createdAt DateTime @default(now())
}

model Topic {
  id          String          @id @default(cuid())
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  parentId    String?
  questions   QuestionTopic[]
  subtopics   Subtopic[]
  createdAt   DateTime        @default(now())
}

model SyllabusNode {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  paperCode   String
  subjectName String
  description String?
  createdAt   DateTime @default(now())
}

model Question {
  id             String             @id @default(cuid())
  recordId       String?
  questionGroupId String?           // Shared ID linking English and Hindi equivalents
  examId         String?
  examYearId     String?
  stageId        String?
  paperId        String
  paper          Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  year           Int
  questionNumber Int
  questionType   String             @default("MCQ") // MCQ, SUBJECTIVE_MAINS, ESSAY
  questionText   String
  questionTextEn String?
  questionTextHi String?
  difficulty     String             @default("MEDIUM") // EASY, MEDIUM, HARD
  difficultyLevel String?           @default("MEDIUM")
  subjectId      String?
  topicId        String?
  subtopicId     String?
  marks          Float?             @default(2.0)
  negativeMarks  Float?             @default(0.666)
  sourceId       String?
  sourcePage     String?
  language       String             @default("English") // English, Hindi, Bilingual
  isStatic       Boolean            @default(true)
  status         String             @default("DRAFT") // DRAFT, NEEDS_REVIEW, VERIFIED, PUBLISHED, ARCHIVED
  verifiedAt     DateTime?
  options        QuestionOption[]
  explanation    Explanation?
  answerKeys     AnswerKeyVersion[]
  answers        QuestionAnswer[]
  syllabusMappings QuestionSyllabusMapping[]
  citations      SourceCitation[]
  topics         QuestionTopic[]
  sources        QuestionSource[]
  testQuestions  TestQuestion[]
  attempts       UserAttempt[]
  responses      UserResponse[]
  bookmarks      Bookmark[]
  notes          UserNote[]
  schedules      ReviewSchedule[]
  storyLinks     StoryQuestionLink[]
  ncertLinks     NCERTChapterQuestionLink[]
  verificationStatus String         @default("OFFICIALLY_VERIFIED") // OFFICIALLY_VERIFIED, INDEPENDENTLY_CORROBORATED, EXPERT_REVIEWED, PENDING_VERIFICATION, DISPUTED
  examCategory   String             @default("CSE") // CSE, CDS, NDA, CAPF, EPFO, ESE
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([paperId, year, questionNumber])
  @@index([year, paperId, status])
  @@index([questionGroupId])
  @@index([examCategory, year])
  @@index([status])
}

model QuestionOption {
  id           String       @id @default(cuid())
  questionId   String
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionCode   String       // A, B, C, D
  optionLabel  String?      // A, B, C, D
  optionText   String
  optionTextEn String?
  optionTextHi String?
  optionOrder  Int          @default(1)
  isCorrect    Boolean      @default(false)
  responses    UserResponse[]
  createdAt    DateTime     @default(now())

  @@unique([questionId, optionCode])
}

model Explanation {
  id                   String    @id @default(cuid())
  questionId           String    @unique
  question             Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  summary              String
  detailedExplanation  String
  eliminationTechnique String?
  sourceCitation       String?
  relatedConcept       String?
  explanationEn        String?
  explanationHi        String?
  explanationSource    String?
  explanationType      String?   @default("PEDAGOGICAL")
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model QuestionAnswer {
  id                 String    @id @default(cuid())
  questionId         String
  question           Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText         String?
  answerOption       String    // A, B, C, D, or DROPPED
  answerType         String    @default("FINAL") // FINAL, PROVISIONAL, AMBIGUOUS, DROPPED
  answerKeyType      String    @default("UPSC_FINAL_KEY") // UPSC_FINAL_KEY, UPSC_PROVISIONAL_KEY, PROVIDER_DERIVED, FACULTY_DERIVED, UNVERIFIED, NO_KEY_FOUND
  answerProvenance   String    @default("UPSC_OFFICIAL_FINAL")
  verificationStatus String    @default("OFFICIALLY_VERIFIED")
  sourceId           String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([questionId])
  @@index([answerKeyType])
}

model AnswerKeyVersion {
  id              String   @id @default(cuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  officialAnswer  String   // A, B, C, D, or DROPPED
  sourceType      String   @default("UPSC_OFFICIAL_FINAL")
  sourceReference String?
  notes           String?
  createdAt       DateTime @default(now())
}

model QuestionTopic {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
}

model SourceDocument {
  id          String           @id @default(cuid())
  title       String
  sourceUrl   String
  fileHash    String?
  paperCode   String?
  year        Int?
  sources     QuestionSource[]
  createdAt   DateTime         @default(now())
}

model QuestionSource {
  id          String         @id @default(cuid())
  questionId  String
  question    Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  documentId  String
  document    SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Test {
  id          String         @id @default(cuid())
  paperId     String
  paper       Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isFullPaper Boolean        @default(true)
  year        Int?
  questions   TestQuestion[]
  sessions    TestSession[]
  createdAt   DateTime       @default(now())
}

model TestQuestion {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex  Int

  @@unique([testId, questionId])
}

model TestSession {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId               String
  test                 Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  status               String         @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  startedAt            DateTime       @default(now())
  submittedAt          DateTime?
  totalTimeSpentSeconds Int           @default(0)
  totalQuestions       Int            @default(0)
  attemptedCount       Int            @default(0)
  correctCount         Int            @default(0)
  incorrectCount       Int            @default(0)
  unattemptedCount     Int            @default(0)
  rawScore             Float          @default(0.0)
  negativeMarks        Float          @default(0.0)
  netScore             Float          @default(0.0)
  responses            UserResponse[]
}

model UserAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   String?
  isCorrect        Boolean
  timeSpentSeconds Int      @default(0)
  mode             String   @default("LEARN") // LEARN, EXAM
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model UserResponse {
  id               String          @id @default(cuid())
  sessionId        String
  session          TestSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId         String?
  option           QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  selectedCode     String?
  isCorrect        Boolean         @default(false)
  isMarkedReview   Boolean         @default(false)
  timeSpentSeconds Int             @default(0)
  createdAt        DateTime        @default(now())

  @@index([sessionId])
  @@index([userId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  folderTag  String?  @default("Default")
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId, folderTag])
}

model UserNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

model ReviewSchedule {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  repetitionCount Int       @default(0)
  intervalDays    Int       @default(1)
  easeFactor      Float     @default(2.5)
  nextReviewDate  DateTime
  isResolved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, questionId])
  @@index([userId, isResolved, nextReviewDate])
}

model StudyGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subject     String?
  targetDate  DateTime?
  targetHours Float     @default(50.0)
  isAchieved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudyActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType    String   // mcq_attempted, test_completed, note_added, revision_done
  label           String
  refId           String?
  durationSeconds Int      @default(0)
  timestamp       DateTime @default(now())
}

model ContentImportJob {
  id               String   @id @default(cuid())
  adminId          String
  admin            User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  fileName         String
  paperYear        Int
  paperCode        String
  totalRecords     Int      @default(0)
  importedCount    Int      @default(0)
  rejectedCount    Int      @default(0)
  status           String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorReportJson  String?
  createdAt        DateTime @default(now())
}

model ContentReview {
  id           String   @id @default(cuid())
  questionId   String
  reviewerId   String
  action       String   // APPROVED, REJECTED, EDITED
  comments     String?
  reviewedAt   DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action       String   // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, ANSWER_KEY_CHANGE
  entityType   String   // QUESTION, ANSWER_KEY, IMPORT_JOB
  entityId     String
  detailsJson  String?
  timestamp    DateTime @default(now())
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique // "FREE", "BEGINNER", "ACHIEVER", "SCHOLAR"
  name          String
  tagline       String?
  tier          Int            @default(0) // 0: Free, 1: Beginner, 2: Achiever, 3: Scholar
  isPopular     Boolean        @default(false)
  isActive      Boolean        @default(true)
  orderIndex    Int            @default(1)
  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PlanPrice {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingInterval String   // "MONTHLY", "QUARTERLY", "ANNUAL"
  amountRupees    Float    // e.g. 0, 499, 1299, 3999
  currency        String   @default("INR")
  discountPercent Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([planId, billingInterval])
}

model PlanFeature {
  id          String   @id @default(cuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureCode String   // "PYQ_BROWSE", "LEARN_EXPLANATIONS", "BOOKMARKS_LIMIT", "TIMED_EXAMS", "ADVANCED_ANALYTICS", "MISTAKE_REVISION"
  featureName String
  isIncluded  Boolean  @default(true)
  limitValue  Int?     // null = unlimited, or e.g. 5, 50
  tooltip     String?
  createdAt   DateTime @default(now())

  @@unique([planId, featureCode])
}

model FeatureEntitlement {
  id          String   @id @default(cuid())
  featureCode String   @unique // "TIMED_EXAMS", "ADVANCED_ANALYTICS", "UNLIMITED_NOTES", "PRIORITY_SUPPORT"
  name        String
  description String
  minTier     Int      @default(1) // Minimum plan tier required
  createdAt   DateTime @default(now())
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan                @relation(fields: [planId], references: [id])
  billingInterval    String              @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUAL"
  status             String              @default("ACTIVE") // "ACTIVE", "PAST_DUE", "CANCELED", "EXPIRED", "INCOMPLETE"
  currentPeriodStart DateTime            @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean             @default(false)
  canceledAt         DateTime?
  providerSubId      String?
  events             SubscriptionEvent[]
  payments           PaymentRecord[]
  paymentOrders      PaymentOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, status, currentPeriodEnd])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String       // "CREATED", "ACTIVATED", "RENEWED", "CANCELED", "PAYMENT_FAILED", "PLAN_CHANGED"
  payloadJson    String?
  createdAt      DateTime     @default(now())
}

model PaymentRecord {
  id             String         @id @default(cuid())
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String         @default("INR")
  status         String         @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "REFUNDED"
  provider       String         @default("SANDBOX") // "RAZORPAY", "STRIPE", "SANDBOX"
  providerTxId   String?        @unique
  idempotencyKey String?        @unique
  paymentMethod  String?        // "UPI", "CARD", "NETBANKING"
  receiptNumber  String?
  refunds        RefundRecord[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RefundRecord {
  id               String        @id @default(cuid())
  paymentRecordId  String
  paymentRecord    PaymentRecord @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String        @default("INR")
  reason           String?
  status           String        @default("COMPLETED") // "PENDING", "COMPLETED", "REJECTED"
  providerRefundId String?
  processedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())
}

// ==========================================
// UPI GATEWAY INTEGRATION MODELS
// ==========================================

model PaymentOrder {
  id                String                @id @default(cuid())
  clientOrderId     String                @unique // Internal unique reference, e.g. "UPICHECKOUT_1731718000_abc"
  gatewayOrderId    String?               @unique // External UPI Gateway order_id, e.g. "ORD20261115ABC12345"
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType       String                @default("SUBSCRIPTION") // "SUBSCRIPTION", "TEST_SERIES", "MAINS_EVALUATION", "COURSE"
  productId         String?               // Plan code ("ACHIEVER") or Test ID
  subscriptionId    String?
  subscription      Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount            Float                 // Amount in INR rupees (e.g. 5499.00)
  amountPaise       Int                   // Amount in integer paise (e.g. 549900)
  currency          String                @default("INR")
  status            String                @default("PENDING") // "PENDING", "PROCESSING", "PAID", "FAILED", "EXPIRED", "UNDER_REVIEW", "REFUNDED"
  environment       String                @default("sandbox") // "live" or "sandbox"
  isTest            Boolean               @default(true)
  paymentUrl        String?
  upiIntent         String?
  utr               String?               // Bank transaction reference / UTR
  metadataJson      String?               // JSON metadata (e.g. billing interval, items)
  expiresAt         DateTime?
  paidAt            DateTime?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  webhookEvents     PaymentWebhookEvent[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([gatewayOrderId])
  @@index([clientOrderId])
}

model PaymentWebhookEvent {
  id             String        @id @default(cuid())
  eventId        String        @unique // UUID from X-Event-Id header and payload event_id
  eventSequence  Int?          // Monotonically increasing sequence number from outbox
  eventType      String        // e.g. "order.paid", "order.expired", "order.under_review"
  orderId        String?       // Gateway order_id
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  environment    String        @default("sandbox") // "live" or "sandbox"
  signature      String?       // X-Signature header
  rawPayload     String        // Exact raw JSON body
  status         String        @default("PROCESSED") // "PROCESSED", "IGNORED", "FAILED"
  errorDetails   String?
  occurredAt     DateTime?
  processedAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([orderId, eventType])
  @@index([eventId])
}

// ==========================================
// CURRENT AFFAIRS & DAILY QUIZ PIPELINE
// ==========================================

model CurrentAffairsStory {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  summary          String
  content          String
  importancePrelims String?
  importanceMains  String?
  sourceName       String               // e.g. "PIB Delhi", "The Hindu", "PRS Legislative"
  sourceUrl        String
  sourceDate       DateTime?
  publishedAt      DateTime             @default(now())
  status           String               @default("PUBLISHED") // "PUBLISHED", "FACT_CHECK_REQUIRED", "DRAFT", "ARCHIVED"
  termsList        String?              // Comma-separated or JSON list of key terms
  prelimsFodder    String?
  mainsFodder      String?
  viewCount        Int                  @default(0)
  topics           StoryTopic[]
  questionLinks    StoryQuestionLink[]
  quizQuestions    DailyQuizQuestion[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, publishedAt])
}

model StoryTopic {
  id             String              @id @default(cuid())
  storyId        String
  story          CurrentAffairsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  syllabusPaper  String              // "GS1", "GS2", "GS3", "GS4", "PRELIMS"
  topicName      String
  confidence     Float               @default(0.95)
  createdAt      DateTime            @default(now())
}

model StoryQuestionLink {
  id                    String              @id @default(cuid())
  storyId               String
  story                 CurrentAffairsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  relationshipRationale String
  createdAt             DateTime            @default(now())

  @@unique([storyId, questionId])
}

model DailyQuiz {
  id             String              @id @default(cuid())
  quizDate       DateTime            @unique // Unique per calendar day
  title          String
  description    String?
  totalQuestions Int                 @default(5)
  isPublished    Boolean             @default(true)
  questions      DailyQuizQuestion[]
  attempts       DailyQuizAttempt[]
  createdAt      DateTime            @default(now())
}

model DailyQuizQuestion {
  id            String               @id @default(cuid())
  dailyQuizId   String
  dailyQuiz     DailyQuiz            @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  storyId       String?
  story         CurrentAffairsStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  orderIndex    Int                  @default(1)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String               // "A", "B", "C", "D"
  explanation   String
  createdAt     DateTime             @default(now())
}

model DailyQuizAttempt {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuizId     String
  dailyQuiz       DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
  score           Float
  totalMarks      Float     @default(10.0)
  accuracyPercent Float
  answersJson     String    // JSON string of user answers { questionId: selectedOption }
  completedAt     DateTime  @default(now())

  @@unique([userId, dailyQuizId])
}

// ==========================================
// COMPREHENSIVE MULTI-EXAM CATALOGUE
// ==========================================

model ExamDirectory {
  id                         String   @id @default(cuid())
  code                       String   @unique // "CSE", "IFS", "CDS", "NDA", "CAPF", "ESE", "CMS", "EPFO"
  name                       String
  conductingBody             String   @default("UPSC")
  category                   String   @default("Civil Services") // "Defence", "Engineering", "Medical", etc.
  overview                   String
  eligibilityQualifications  String
  ageLimit                   String
  attemptsAllowed            String
  stagesDescription          String
  officialNotificationUrl    String
  syllabusOverview           String
  examCycleDates             String?  // e.g. "Notification: Feb, Prelims: May, Mains: Sep"
  totalVacanciesTypical      String?
  isActive                   Boolean  @default(true)
  orderIndex                 Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// ==========================================
// MAINS ANSWER-WRITING WORKSPACE
// ==========================================

model MainsQuestion {
  id                String       @id @default(cuid())
  paperCode         String       // "GS1", "GS2", "GS3", "GS4", "ESSAY"
  year              Int
  questionNumber    Int
  questionText      String
  marks             Int          @default(10) // 10 or 15 marks
  wordLimit         Int          @default(150) // 150 or 250 words
  theme             String       // e.g. "Modern History", "Governance", "Ethics Case Study"
  frameworkGuidance String?      // Introduction, Body dimensions, Conclusion guidance
  drafts            MainsDraft[]
  createdAt         DateTime     @default(now())

  @@unique([paperCode, year, questionNumber])
  @@index([paperCode, year])
}

model MainsDraft {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainsQuestionId      String
  mainsQuestion        MainsQuestion @relation(fields: [mainsQuestionId], references: [id], onDelete: Cascade)
  userAnswer           String
  wordCount            Int           @default(0)
  timeSpentSeconds     Int           @default(0)
  selfEvaluationScore  Float?
  selfEvaluationNotes  String?
  aiFeedbackJson       String?
  isSubmitted          Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([userId, mainsQuestionId])
  @@index([userId, isSubmitted])
}

// ==========================================
// OPERATIONS, SCHEDULING & MONITORING
// ==========================================

model BackgroundJob {
  id           String    @id @default(cuid())
  jobType      String    // "SOURCE_AUDIT", "CURRENT_AFFAIRS_CRAWL", "PAPER_DISCOVERY", "STALENESS_CHECK"
  status       String    @default("QUEUED") // "QUEUED", "RUNNING", "SUCCESS", "FAILED"
  summary      String?
  errorDetails String?
  durationMs   Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model SourceRegistryRecord {
  id               String    @id @default(cuid())
  sourceId         String    @unique
  sourceName       String
  canonicalDomain  String
  sourceType       String    // "OFFICIAL_GOVERNMENT", "EDUCATIONAL_CORROBORATION", "SEARCH_DISCOVERY"
  priority         Int       @default(1) // 1: Highest (Official), 2: Educational, 3: Search
  collectionMethod String    // "DOCUMENT_DOWNLOAD", "INDEX_ONLY", "METADATA_DEEP_LINK"
  termsUrl         String?
  robotsStatus     String    @default("ALLOWED") // "ALLOWED", "DISALLOWED", "RESTRICTED"
  lastStatusCode   Int       @default(200)
  lastCheckedAt    DateTime  @default(now())
  lastSuccessAt    DateTime?
  isHealthy        Boolean   @default(true)
  errorMessage     String?
  createdAt        DateTime  @default(now())
}

// ==========================================
// NCERT KNOWLEDGE BASE & TEXTBOOK CATALOG
// ==========================================

model NCERTBook {
  id                String         @id @default(cuid())
  classNumber       Int            // 6, 7, 8, 9, 10, 11, 12
  subject           String         // "History", "Geography", "Polity", "Economy", "Science", "Sociology"
  bookTitle         String         // e.g. "Indian Constitution at Work", "Themes in Indian History - Part I"
  medium            String         @default("English")
  coverUrl          String?
  officialPortalUrl String         // Link to official portal at ncert.nic.in / epathshala.nic.in
  copyrightNotice   String         @default("Copyright © National Council of Educational Research and Training (NCERT), New Delhi. Links provided for educational navigation under fair dealing.")
  chapters          NCERTChapter[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([classNumber, subject, bookTitle])
  @@index([classNumber, subject])
}

model NCERTChapter {
  id                String                     @id @default(cuid())
  bookId            String
  book              NCERTBook                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber     Int
  chapterTitle      String
  slug              String
  officialPdfUrl    String                     // Official NCERT reader URL
  keyTopics         String                     // Key syllabus concepts covered
  summary           String?                    // Independently authored educational summary
  questionLinks     NCERTChapterQuestionLink[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([bookId, chapterNumber])
  @@index([chapterTitle])
}

model NCERTChapterQuestionLink {
  id            String       @id @default(cuid())
  chapterId     String
  chapter       NCERTChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  relevanceNote String?
  createdAt     DateTime     @default(now())

  @@unique([chapterId, questionId])
  @@index([chapterId])
  @@index([questionId])
}

// ==========================================
// HISTORICAL EXAMINATION PERIODS & PATTERNS
// ==========================================

model HistoricalExamPeriod {
  id                 String   @id @default(cuid())
  examCode           String   // "CSE", "CDS", "NDA", etc.
  periodLabel        String   // e.g. "1979-2010 (Kothari Pattern - Optional in Prelims)"
  startYear          Int
  endYear            Int?
  patternDescription String
  qualifyingRules    String
  createdAt          DateTime @default(now())
}

// ==========================================
// BACKGROUND EXTRACTION JOBS & QUALITY REPORTS
// ==========================================

model ExtractionJob {
  id              String    @id @default(cuid())
  jobType         String    // "PDF_EXTRACTION", "OCR_SCAN", "ANSWER_KEY_SYNC", "CLASSIFICATION"
  targetSource    String    // "UPSC_OFFICIAL", "NCERT_PORTAL", "ARCHIVE"
  examCode        String
  year            Int
  paperCode       String
  status          String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  totalFound      Int       @default(0)
  extractedCount  Int       @default(0)
  failedCount     Int       @default(0)
  confidenceScore Float     @default(0.95)
  errorLog        String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([status, examCode, year])
}

model DataQualityReport {
  id                  String   @id @default(cuid())
  reportType          String   // "DUPLICATE_CHECK", "OCR_AUDIT", "ANSWER_VERIFICATION"
  totalAudited        Int      @default(0)
  duplicatesFound     Int      @default(0)
  missingOptionsFound Int      @default(0)
  ocrConfidenceAvg    Float    @default(0.98)
  issuesSummary       String?
  createdAt           DateTime @default(now())
}

// ==========================================
// MASTER LIBRARY NORMALIZED ENTITIES
// ==========================================

model ExamYear {
  id                 String   @id @default(cuid())
  examFamily         String   // e.g. "Civil Services Examination (CSE)", "Combined Defence Services (CDS)"
  year               Int      // 1995 to 2026
  paperOrStage       String?  // e.g. "Prelims GS I; Prelims CSAT", "GS1-GS4 and Essay"
  language           String   @default("English/Hindi")
  officialSourceUrl  String?
  downloadStatus     String   @default("NOT_HARVESTED") // NOT_HARVESTED, DISCOVERED, DOWNLOADED, EXTRACTED, VERIFIED, ACCESS_BLOCKED
  verificationStatus String   @default("NOT_VERIFIED")  // NOT_VERIFIED, OFFICIALLY_VERIFIED, SECONDARY_CORROBORATED
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([examFamily, year, paperOrStage])
  @@index([examFamily, year])
  @@index([downloadStatus])
}

model Subtopic {
  id             String          @id @default(cuid())
  topicId        String
  topic          Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopicName   String
  description    String?
  syllabusTopics SyllabusTopic[]
  createdAt      DateTime        @default(now())

  @@unique([topicId, subtopicName])
  @@index([topicId])
}

model SyllabusTopic {
  id                 String                    @id @default(cuid())
  examId             String?
  paperId            String?
  subjectId          String?
  topicId            String?
  subtopicId         String?
  subtopic           Subtopic?                 @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  syllabusVersion    String                    @default("2024-2026")
  syllabusText       String
  officialSourceUrl  String?
  questionMappings   QuestionSyllabusMapping[]
  createdAt          DateTime                  @default(now())

  @@index([paperId, subjectId])
}

model QuestionSyllabusMapping {
  id              String        @id @default(cuid())
  questionId      String
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  syllabusTopicId String
  syllabusTopic   SyllabusTopic @relation(fields: [syllabusTopicId], references: [id], onDelete: Cascade)
  mappingType     String        @default("PRIMARY") // PRIMARY, SECONDARY, CONTEXTUAL
  confidenceScore Float         @default(0.95)
  mappingMethod   String        @default("MANUAL_VERIFIED") // MANUAL_VERIFIED, SYLLABUS_TAXONOMY, AI_ASSISTED
  reviewedStatus  String        @default("REVIEWED") // REVIEWED, PENDING_REVIEW
  createdAt       DateTime      @default(now())

  @@unique([questionId, syllabusTopicId])
  @@index([questionId])
  @@index([syllabusTopicId])
}

model KnowledgeSource {
  id               String           @id @default(cuid())
  sourceName       String
  sourceType       String           // OFFICIAL, SECONDARY_PROVIDER, RESEARCH, NEWS, STATUTORY
  canonicalUrl     String           @unique
  publisher        String
  contentType      String           // PYQ, SYLLABUS, CURRENT_AFFAIRS, ANSWER_KEY, STUDY_MATERIAL
  language         String           @default("English")
  rightsStatus     String           @default("PUBLIC_DOMAIN") // PUBLIC_DOMAIN, FAIR_DEALING_INDEX, COPYRIGHT_RESTRICTED
  accessStatus     String           @default("ACCESSIBLE") // ACCESSIBLE, LOGIN_REQUIRED, ACCESS_BLOCKED
  reliabilityLevel String           @default("PRIMARY_OFFICIAL") // PRIMARY_OFFICIAL, SECONDARY_VERIFIED, UNVERIFIED
  retrievedAt      DateTime         @default(now())
  lastCheckedAt    DateTime         @default(now())
  sourceRecords    SourceRecord[]
  citations        SourceCitation[]
  createdAt        DateTime         @default(now())

  @@index([sourceType])
  @@index([rightsStatus])
}

model SourceRecord {
  id                 String          @id @default(cuid())
  sourceId           String
  source             KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalRecordId   String?
  originalUrl        String
  originalTitle      String
  sourcePage         String?
  extractionStatus   String          @default("DISCOVERED") // DISCOVERED, FETCHED, EXTRACTED, PARTIALLY_EXTRACTED, VERIFIED, ACCESS_BLOCKED, NOT_FOUND, NOT_PUBLISHED, NEEDS_MANUAL_REVIEW, REJECTED
  checksum           String?
  verificationStatus String          @default("PENDING_VERIFICATION")
  createdAt          DateTime        @default(now())

  @@index([sourceId])
  @@index([extractionStatus])
}

model SourceCitation {
  id           String          @id @default(cuid())
  questionId   String
  question     Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceId     String
  source       KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceUrl    String
  pageNumber   String?
  evidenceType String          @default("OFFICIAL_GAZETTE") // OFFICIAL_GAZETTE, STATUTE, SUPREME_COURT, PIB, NCERT, TEXTBOOK
  citationText String
  createdAt    DateTime        @default(now())

  @@index([questionId])
  @@index([sourceId])
}

model IngestionJobAudit {
  id              String    @id @default(cuid())
  sourceId        String?
  jobType         String    // HARVEST_SYNC, BATCH_IMPORT, OCR_DIGITIZATION, DUPLICATE_DETECTION
  status          String    @default("RUNNING") // RUNNING, COMPLETED, FAILED, PARTIAL
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  totalDiscovered Int       @default(0)
  totalFetched    Int       @default(0)
  totalExtracted  Int       @default(0)
  totalVerified   Int       @default(0)
  totalFailed     Int       @default(0)
  errorLog        String?
  createdAt       DateTime  @default(now())

  @@index([jobType, status])
}


