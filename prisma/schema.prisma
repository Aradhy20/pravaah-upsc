model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  discountAmount Float
  redeemedAt     DateTime @default(now())

  @@index([couponId, userId])
}

model Referral {
  id             String   @id @default(cuid())
  referrerUserId String
  referrer       User     @relation("ReferrerRelation", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String?  @unique
  referredUser   User?    @relation("ReferredRelation", fields: [referredUserId], references: [id], onDelete: SetNull)
  referralCode   String   @unique
  status         String   @default("PENDING") // "PENDING", "QUALIFIED", "REWARDED"
  rewardPoints   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([referrerUserId, status])
}

model SpecializedPack {
  id              String             @id @default(cuid())
  code            String             @unique // "CSAT_INTENSIVE", "MAINS_EVAL_PACK", "INTERVIEW_PREP", "MOCK_SERIES_ADV", "CURRENT_AFFAIRS_REV"
  name            String
  nameHi          String?
  tagline         String
  category        String             // "CSAT", "MAINS", "INTERVIEW", "MOCK", "CURRENT_AFFAIRS"
  priceRupees     Float
  featuresJson    String             // JSON string of feature list
  creditsIncluded Int                @default(0) // e.g. 10 evaluations
  validityDays    Int                @default(365)
  isActive        Boolean            @default(true)
  purchases       UserPackPurchase[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category, isActive])
}

model UserPackPurchase {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId           String
  pack             SpecializedPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  purchasePrice    Float
  status           String          @default("ACTIVE") // "ACTIVE", "EXPIRED", "REFUNDED"
  creditsRemaining Int             @default(0)
  expiresAt        DateTime
  createdAt        DateTime        @default(now())

  @@index([userId, status, expiresAt])
}

// ==========================================
// UPSC ALL-EXAMS CORPUS REPOSITORY
// ==========================================

model CorpusSource {
  id            String           @id // matches source_id e.g. upsc_official_registry
  sourceName    String
  sourceKind    String
  authority     String           @default("UPSC")
  url           String
  lastChecked   String?
  observedCount String?
  note          String?
  exams         CorpusExam[]
  documents     CorpusDocument[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CorpusExam {
  id             String           @id // matches exam_id e.g. cse_prelims_2024
  examName       String
  year           Int
  examFamily     String           // "CSE", "CDS", "NDA", "IFOS", "CAPF", "CMS", "ESE", "CGS", "IES_ISS", "CISF_LDCE", "OTHER"
  sourceId       String?
  source         CorpusSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  registryStatus String?
  documents      CorpusDocument[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([examFamily, year])
  @@index([year])
}

model CorpusDocument {
  id                 String               @id // matches document_id
  examId             String?
  exam               CorpusExam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  examName           String
  year               Int
  paper              String
  documentType       String               // "Question Paper", "Answer Key", "Cut-off Marks", etc.
  authority          String               @default("UPSC")
  sourceUrl          String
  uploaded           String?
  fileSize           String?
  verificationStatus String               @default("OFFICIAL_REGISTRY_VERIFIED")
  sourceRef          String?
  localPath          String?
  fileHashSha256     String?
  extractionStatus   String               @default("NOT_EXTRACTED") // "NOT_EXTRACTED", "EXTRACTED", "NEEDS_OCR", "FAILED"
  note               String?
  sourceId           String?
  source             CorpusSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  pages              CorpusDocumentPage[]
  questions          Question[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([examId, documentType])
  @@index([year, documentType])
  @@index([extractionStatus])
}

model CorpusDocumentPage {
  id                String         @id @default(cuid())
  documentId        String
  document          CorpusDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber        Int
  pageText          String         @db.Text
  extractionQuality String         @default("USABLE_TEXT") // "USABLE_TEXT", "LOW_TEXT_NEEDS_OCR", "EMPTY"
  characterCount    Int            @default(0)
  hasHindi          Boolean        @default(false)
  hasEnglish        Boolean        @default(true)
  createdAt         DateTime       @default(now())

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model GeneratedPracticeQuestion {
  id              String   @id @default(cuid())
  practiceId      String   @unique
  examFamily      String   @default("CSE")
  syllabusSubject String
  syllabusTopic   String?
  difficulty      String   @default("MEDIUM")
  questionText    String   @db.Text
  optionA         String   @db.Text
  optionB         String   @db.Text
  optionC         String   @db.Text
  optionD         String   @db.Text
  answerLetter    String
  explanation     String   @db.Text
  generationModel String?
  generatedAt     String?
  reviewStatus    String   @default("UNVERIFIED_PRACTICE")
  contentLabel    String   @default("GENERATED_PRACTICE_NOT_OFFICIAL_PYQ")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([syllabusSubject, difficulty])
  @@index([contentLabel])
}

model CorpusIngestionJob {
  id              String    @id @default(cuid())
  runId           String    @unique
  action          String    // SYNC_REGISTRY, BATCH_DOWNLOAD, TEXT_EXTRACTION, QUESTION_STAGING, ANSWER_KEY_IMPORT, PRACTICE_IMPORT
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  recordsSeen     Int       @default(0)
  recordsAdded    Int       @default(0)
  errors          Int       @default(0)
  status          String    @default("COMPLETED") // RUNNING, COMPLETED, FAILED
  note            String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([action, status])
}



