# Neon PostgreSQL Connection String (e.g. postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEXTAUTH_SECRET="pravaah_upsc_secret_development_key_2026"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pravaah UPSC"
NODE_ENV="development"

# UPI Gateway Configuration (External Microservice: https://github.com/mynkdev-21/upi-gateway)
# Hostname of standalone Laravel UPI Gateway deployment (e.g. https://payments.pravaahupsc.com)
UPI_GATEWAY_BASE_URL="https://payments.pravaahupsc.com"

# Merchant Credentials (Provided in Gateway Admin Dashboard -> Merchant API Keys)
UPI_GATEWAY_API_KEY="ug_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPI_GATEWAY_API_SECRET="ugs_live_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# HMAC-SHA256 Webhook Signing Secret (Configured in UPI Gateway Merchant Webhook Settings)
UPI_GATEWAY_WEBHOOK_SECRET="whsec_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"

# Gateway Mode: true for offline sandbox simulation or test mode, false for live real-money payments
UPI_GATEWAY_SANDBOX_MODE="true"
