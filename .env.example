# PostgreSQL Database Connection String (Vercel Storage, Prisma Postgres, or Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pravaah_upsc?schema=public"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://pravaah-upsc.vercel.app"
NEXT_PUBLIC_APP_NAME="Pravaah UPSC"
NODE_ENV="development"

# ==============================================================================
# Cashfree Payment Gateway Configuration (API Version: 2023-08-01)
# Sign up at: https://merchant.cashfree.com/ (Production) or https://sandbox.cashfree.com/ (Sandbox)
# ==============================================================================
# Master payment switch: "false" safely pauses online checkout with a polite notice.
# Set to "true" when ready to accept live transactions with valid Cashfree credentials.
ENABLE_PAYMENTS="false"

# Cashfree API Credentials (obtained from Cashfree Merchant Dashboard > Developers > API Keys)
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Cashfree Environment: "sandbox" (or "TEST") for sandbox testing; "production" (or "PROD") for live transactions
CASHFREE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_CASHFREE_ENVIRONMENT="sandbox"

# Cashfree API Version (mandatory for hosted web checkout v3)
CASHFREE_API_VERSION="2023-08-01"

# Webhook Secret: Used for HMAC-SHA256 signature verification of webhook events
# Configure in Cashfree Dashboard > Developers > Webhooks > Add Webhook
# Set Webhook URL to: https://pravaah-upsc.vercel.app/api/webhooks/cashfree
CASHFREE_WEBHOOK_SECRET=""

# Google OAuth 2.0 Authentication (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
