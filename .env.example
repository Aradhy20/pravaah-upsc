# PostgreSQL Database Connection String (Vercel Storage, Prisma Postgres, or Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pravaah_upsc?schema=public"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://pravaah-upsc.vercel.app"
NEXT_PUBLIC_APP_NAME="Pravaah UPSC"
NODE_ENV="development"

# Cashfree Payments Configuration Contract (Future Integration)
# Note: Keep disabled until merchant profile approval is complete.
ENABLE_PAYMENTS="false"
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENVIRONMENT="TEST" # "TEST" for sandbox, "PROD" for production
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_WEBHOOK_SECRET=""

# Google OAuth 2.0 Authentication (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
