# ==============================================================================
# PRAVAAH UPSC - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (REQUIRED)
# Connect to authoritative Neon Serverless PostgreSQL with connection pooling
# ------------------------------------------------------------------------------
NEON_DATABASE_URL="postgresql://user:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional direct unpooled connection for interactive CLI operations only:
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BILLING & WEBHOOK SECURITY (REQUIRED IN PRODUCTION)
# Used to verify genuine HMAC-SHA256 signatures on /api/v1/billing/webhook
# Generate using: openssl rand -hex 32
# ------------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET="generate-32-byte-hex-secret-with-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# 3. RUNTIME ENVIRONMENT
# Set to "production" in Vercel, "development" locally
# ------------------------------------------------------------------------------
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. OPTIONAL & LEGACY APPLICATION CONFIGURATION
# Note: Pravaah UPSC implements custom cryptographic scrypt/SHA-256 server-side
# sessions (lib/auth.ts). NextAuth is not installed.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Pravaah UPSC"
NEXTAUTH_SECRET="optional-legacy-session-secret"
NEXTAUTH_URL="http://localhost:3000"
